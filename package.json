{
  "name": "@belikenikola/wcag-audit",
  "version": "1.1.2",
  "description": "WCAG 2.1 accessibility auditor — CLI + library. Actionable reports and prioritized to-do lists, powered by axe-core and Playwright.",
  "type": "module",
  "main": "./src/lib.js",
  "exports": {
    ".": "./src/lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "wcag-audit": "./bin/wcag-audit.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/wcag-audit.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag2",
    "audit",
    "cli",
    "axe-core",
    "playwright"
  ],
  "author": "belikenikola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belikenikola/a11y-audit.git"
  },
  "homepage": "https://github.com/belikenikola/a11y-audit#readme",
  "bugs": {
    "url": "https://github.com/belikenikola/a11y-audit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "axe-core": "^4.10.2",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "ora": "^8.1.1",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

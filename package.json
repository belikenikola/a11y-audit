{
  "name": "a11y-audit",
  "version": "1.0.0",
  "description": "CLI tool for WCAG 2.1 accessibility auditing with actionable reports and to-do lists",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "a11y-audit": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "audit",
    "cli",
    "axe-core"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "axe-core": "^4.10.2",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "ora": "^8.1.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
